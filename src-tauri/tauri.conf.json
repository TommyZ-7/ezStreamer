{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ezStreamer",
  "version": "0.1.0-preview09",
  "identifier": "app.ezstreamer.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ezStreamer",
        "width": 960,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.png"],
    "resources": ["resources/licenses/*", "resources/gstreamer/**/*"]
  }
}
